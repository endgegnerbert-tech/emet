{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/endgegnerbert-tech/emet/schemas/router-training-row.schema.json",
  "title": "emet router canonical training row",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "task", "query", "mode", "labels", "source_state", "review"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "task": { "enum": ["domain", "query_understanding", "sufficiency", "conflict", "followup"] },
    "split": { "type": ["string", "null"], "enum": ["train", "dev", "test", "gold", null] },
    "query": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["fast", "deep", "code", "academic"] },
    "input_text": { "type": "string" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_shape": { "type": "string" },
        "answer_shape": { "type": "string" },
        "source_family": { "type": "string" },
        "recency_need": { "type": "string" },
        "ambiguity": { "type": "string" },
        "domain": { "type": "string" },
        "sufficiency": { "type": "string" },
        "conflict": { "type": "string" },
        "next_action": { "type": "string" }
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "authority_count", "primary_count", "recent_count", "distinct_domain_count", "conflict_score", "version_match_score"],
      "properties": {
        "source_count": { "type": "number", "minimum": 0 },
        "authority_count": { "type": "number", "minimum": 0 },
        "primary_count": { "type": "number", "minimum": 0 },
        "recent_count": { "type": "number", "minimum": 0 },
        "distinct_domain_count": { "type": "number", "minimum": 0 },
        "conflict_score": { "type": "number", "minimum": 0 },
        "version_match_score": { "type": "number", "minimum": 0 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "confidence", "needs_human_review"],
      "properties": {
        "source": { "enum": ["human", "pi_review", "llm_review", "weak_label", "synthetic"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_human_review": { "type": "boolean" },
        "reviewer_model": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": ["string", "null"] },
        "log_path": { "type": ["string", "null"] },
        "cache_key": { "type": ["string", "null"] },
        "original_review_source": { "type": ["string", "null"] },
        "label_quality_tier": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 }
      }
    }
  }
}
