    "emet.js",
    "emet-mcp.js",
    "README.md",
    "server.json",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endgegnerbert-tech/emet.git"
  },
  "homepage": "https://github.com/endgegnerbert-tech/emet#readme",
  "bugs": {
    "url": "https://github.com/endgegnerbert-tech/emet/issues"
  },
  "keywords": [
    "pi-package",
    "mcp",
