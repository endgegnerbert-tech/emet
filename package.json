{
  "name": "@black-knight.dev/emet",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "Zero-setup grounded web research MCP server and Pi extension for AI coding agents.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./web-research": "./lib/web-research.js",
    "./research": "./lib/research.js",
    "./research-contract": "./lib/research-contract.js",
    "./research-flow": "./lib/research-flow.js",
    "./mcp-server": "./mcp-server.js",
    "./mcp": "./mcp/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "emet": "bin/emet.js",
    "emet-mcp": "bin/emet-mcp.js"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    ".codex-plugin",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "configs",
    "docs/README.md",
    "docs/examples.md",
    "docs/hosts",
    "docs/reference",
    "docs/tool-reference.md",
    "docs/pipeline.md",
    "docs/quickstarts.md",
    "docs/releases",
    "emet-mcp.js",
    "emet.js",
    "extensions",
    "index.js",
    "lib",
    "lib/research-contract.js",
    "lib/research-flow.js",
    "lib/research-intent.js",
    "lib/research-session.js",
    "lib/research.js",
    "lib/research/cache.js",
    "lib/research/config.js",
    "lib/research/fetch.js",
    "lib/research/helpers.js",
    "lib/research/pipeline.js",
    "lib/research/queries.js",
    "lib/research/search.js",
    "lib/research/synthesis.js",
    "lib/research/coverage.js",
    "lib/research/extraction.js",
    "lib/research/heuristics.js",
    "lib/research/ranking.js",
    "lib/retrieval/community.js",
    "lib/retrieval/normalize.js",
    "mcp",
    "mcp-server.js",
    "package.json",
    "plugins",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endgegnerbert-tech/emet.git"
  },
  "homepage": "https://github.com/endgegnerbert-tech/emet#readme",
  "bugs": {
    "url": "https://github.com/endgegnerbert-tech/emet/issues"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "research",
    "web-research",
    "citations",
    "grounded",
    "docs",
    "developer-tools",
    "ai-agents",
    "npm",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "vscode-copilot"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "eval": "node --test test/eval-runner.test.js",
    "pack:dry": "node scripts/package-surface-audit.mjs && npm pack --dry-run",
    "pack:smoke": "node scripts/package-install-smoke.mjs",
    "check": "npm test && npm run pack:dry && npm run pack:smoke",
    "mcp": "node ./mcp/server.js"
  },
  "dependencies": {
    "@black-knight.dev/pinglet": "^0.2.0",
    "@earendil-works/pi-ai": "^0.80.2",
    "@extractus/article-extractor": "^8.1.0",
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "pdfjs-dist": "^6.0.227",
    "typebox": "^1.1.38"
  },
  "overrides": {
    "protobufjs": "7.6.4"
  },
  "pi": {
    "extensions": [
      "./extensions/emet.ts"
    ],
    "image": "https://raw.githubusercontent.com/endgegnerbert-tech/emet/main/docs/assets/emet-demo.gif"
  },
  "publishConfig": {
    "access": "public"
  }
}
